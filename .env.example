# ============================================================
# Token-Free Gateway — environment variable configuration
# All variables use the TFG_ prefix to avoid conflicts.
#
# Alternatively, you can put these settings in:
#   ~/.token-free-gateway/config.json
#
# Priority: TFG_* env vars > config.json > built-in defaults
# ============================================================

# Gateway API key for client authentication (optional).
# Leave empty to disable auth (any client can connect).
TFG_API_KEY=

# Server listen port (default: 3456)
# TFG_PORT=3456

# Chrome debug port URL used for browser-side requests and webauth (default: http://127.0.0.1:9222)
# TFG_CDP_URL=http://127.0.0.1:9222

# Maximum prompt size before trimming (default: 8000 characters)
TFG_MAX_PROMPT_CHARS=8000

# Per-request timeout in seconds (default: 300)
# TFG_REQUEST_TIMEOUT_SEC=300

# ============================================================
# Docker stack only
# ============================================================

# Browser desktop login. Open https://localhost:${BROWSER_GUI_HOST_PORT}
# and use BROWSER_USER / BROWSER_PASSWORD. Required.
BROWSER_USER=admin
BROWSER_PASSWORD=

# Host ports. The gateway is published through the browser container
# because both share a network namespace.
BROWSER_GUI_HOST_PORT=6081
GATEWAY_HOST_PORT=3457

# Container user mapping. Use `id -u` and `id -g` on the host.
PUID=1000
PGID=1000
TZ=Europe/Lisbon
